<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="15.0" styleClass="root-container" stylesheets="@estilos/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tuempresa.RegistroEmpleadosFX.controller.EmpleadoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="title-label" text="REGISTRO DE EMPLEADOS" />

    <GridPane hgap="10.0" styleClass="form-grid" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label styleClass="form-label" text="Nombres:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombres" styleClass="form-control" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label styleClass="form-label" text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtApellidos" styleClass="form-control" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label styleClass="form-label" text="Cédula:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtCedula" styleClass="form-control" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label styleClass="form-label" text="Correo:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtCorreo" styleClass="form-control" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label styleClass="form-label" text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtTelefono" styleClass="form-control" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label styleClass="form-label" text="Cargo:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="txtCargo" styleClass="form-control" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Label styleClass="form-label" text="Departamento:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="cmbDepartamento" maxWidth="1.7976931348623157E308" styleClass="form-control" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label styleClass="form-label" text="Salario:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <TextField fx:id="txtSalario" styleClass="form-control" GridPane.columnIndex="3" GridPane.rowIndex="3" />

        <Label styleClass="form-label" text="Fecha Contratación:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <DatePicker fx:id="dpFechaContratacion" maxWidth="1.7976931348623157E308" styleClass="form-control" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label styleClass="form-label" text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="4" />
        <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" styleClass="form-control" GridPane.columnIndex="3" GridPane.rowIndex="4" />
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <HBox alignment="CENTER" spacing="15.0" styleClass="button-box">
        <Button fx:id="btnGuardar" onAction="#guardarEmpleado" styleClass="btn-primary" text="Guardar" />
        <Button fx:id="btnLimpiar" onAction="#limpiarCampos" styleClass="btn-secondary" text="Limpiar" />
        <Button fx:id="btnActualizar" onAction="#actualizarTabla" styleClass="btn-action" text="Actualizar tabla" />
        <Button fx:id="btnRegistro" onAction="#actualizarRegistro" styleClass="btn-update-reg" text="Actualizar registro" />
        <Button fx:id="btnEliminar" onAction="#eliminarRegistro" styleClass="btn-danger" text="Eliminar registro" />
    </HBox>

    <Label styleClass="subtitle-label" text="EMPLEADOS REGISTRADOS" />

    <TableView fx:id="tblEmpleados" styleClass="custom-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombres" prefWidth="110.0" text="Nombres" />
            <TableColumn fx:id="colApellidos" prefWidth="110.0" text="Apellidos" />
            <TableColumn fx:id="colCedula" prefWidth="100.0" text="Cédula" />
            <TableColumn fx:id="colCorreo" prefWidth="130.0" text="Correo" />
            <TableColumn fx:id="colTelefono" prefWidth="90.0" text="Teléfono" />
            <TableColumn fx:id="colCargo" prefWidth="110.0" text="Cargo" />
            <TableColumn fx:id="colDepartamento" prefWidth="110.0" text="Departamento" />
            <TableColumn fx:id="colSalario" prefWidth="80.0" text="Salario" />
            <TableColumn fx:id="colFechaContratacion" prefWidth="110.0" text="Fecha Contratación" />
            <TableColumn fx:id="colEstado" prefWidth="80.0" text="Estado" />
        </columns>
    </TableView>
</VBox>
